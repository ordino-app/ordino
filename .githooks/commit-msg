#!/usr/bin/env bash
# Enforces Conventional Commits: type(scope)!: summary
set -euo pipefail
msg=$(head -n1 "$1")
pattern='^(feat|fix|perf|refactor|docs|test|build|ci|chore|revert)(\([a-z0-9._-]+\))?!?: .+'
if [[ "$msg" =~ ^(Merge|Revert|fixup!|squash!) ]] || [[ "$msg" =~ $pattern ]]; then exit 0; fi
echo "commit-msg: use Conventional Commits, e.g. 'feat(engine): add bsp layout'." >&2
exit 1
